# backend/.env.example
# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Supabase (Project Settings → API) ────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-here          # Settings → API → JWT Settings → JWT Secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret! server-side only, bypasses RLS — never expose to frontend
SUPABASE_ANON_KEY=your-anon-public-key            # Settings → API → Project API keys → anon/public — same value as frontend's NEXT_PUBLIC_SUPABASE_ANON_KEY

# ── Supabase Auth Email ───────────────────────────────────
# Magic-link emails require custom SMTP configured in the Supabase
# dashboard (Authentication → Emails → SMTP Settings) — the default
# shared sender has a very low rate limit unsuitable for dev/testing.
# Recommended: Resend (smtp.resend.com, port 465, free tier).

# ── Cache ─────────────────────────────────────────────────
UPSTASH_REDIS_URL=https://your-instance.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token

# ── Internal / scheduler ─────────────────────────────────
SCHEDULER_SECRET=generate-with-openssl-rand-hex-32

# ── Perchie chatbot ───────────────────────────────────────
# Active provider: Google AI Studio (Gemini)
GEMINI_API_KEY=your-google-ai-studio-key          # https://aistudio.google.com/apikey
CHAT_MODEL=gemini-3.8-flash

# Previous provider: Anthropic — kept for future use.
# To switch back: uncomment these two lines, comment out the Gemini lines above,
# and uncomment the Anthropic code in core/config.py and services/chatbot.py.
# ANTHROPIC_API_KEY=sk-ant-...
# CHAT_MODEL=claude-haiku-4-5-20251001

# Optional: also used for Gemini text embeddings in resume/job match scoring.
# Perchie falls back to this key if GEMINI_API_KEY is unset.
# GOOGLE_API_KEY=your-google-api-key

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Paystack ──────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_...

# ── PayPal ────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_WEBHOOK_ID=your-webhook-id
PAYPAL_ENV=sandbox
PAYPAL_KES_PER_USD=129

# backend/.env.example
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=https://api.rolehatch.com/api/wallet/callbacks/stk
MPESA_RESULT_URL=https://api.rolehatch.com/api/wallet/callbacks/b2c-result
MPESA_TIMEOUT_URL=https://api.rolehatch.com/api/wallet/callbacks/b2c-timeout
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_CALLBACK_SECRET=generate-with-openssl-rand-hex-32