# backend/.env.example
# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── Supabase (Project Settings → API) ────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-here          # Settings → API → JWT Settings → JWT Secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret! server-side only, bypasses RLS — never expose to frontend

# ── Cache ─────────────────────────────────────────────────
UPSTASH_REDIS_URL=https://your-instance.upstash.io
UPSTASH_REDIS_TOKEN=your-upstash-token

# ── Internal / scheduler ─────────────────────────────────
SCHEDULER_SECRET=generate-with-openssl-rand-hex-32

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
FRONTEND_URL=http://localhost:3000

# ── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000